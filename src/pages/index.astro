---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BusinessCard from '@/components/BusinessCard.astro';
import Carousel from '@/components/Carousel.astro';
import GroupCard from '@/components/GroupCard.astro';
import JoinRequestForm from '@/components/JoinRequestForm.astro';
import { includeDrafts } from '@/config/build';
import { siteConfig } from '@/config/site';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { visibleItems } from '@/lib/publishing';
import { withBase } from '@/lib/url';

const featured = visibleItems(
  (await getCollection('negocios')).map((entry) => ({ id: entry.id, ...entry.data })),
  false,
).filter((business) => business.featured);

// La portada usa la imagen del primer servicio visible; sin servicios, el hero es solo texto.
const heroService = visibleItems(
  (await getCollection('servicios')).map((entry) => ({ id: entry.id, ...entry.data })),
  includeDrafts,
)[0];

const trustPoints = [
  { value: '2', label: 'grupos de WhatsApp: uno con clientes y otro solo para negocios' },
  { value: '100 %', label: 'de los ingresos los aprueba un administrador, uno a uno' },
  { value: '0', label: 'enlaces de invitación publicados en el sitio' },
] as const;

const conditionsHref = withBase('condiciones/');
// Solo datos visibles en la página (pie: marca, correo y WhatsApp).
const jsonLd = siteConfig.brandName
  ? {
      '@context': 'https://schema.org',
      '@type': 'Organization',
      name: siteConfig.brandName,
      ...(Astro.site ? { url: Astro.site.href } : {}),
      email: siteConfig.contactEmail,
      ...(siteConfig.adminWhatsApp ? { telephone: siteConfig.adminWhatsApp } : {}),
    }
  : undefined;
---

<BaseLayout
  title={siteConfig.name}
  description={siteConfig.description}
  {...(jsonLd ? { jsonLd } : {})}
>
  <section class="hero">
    <div class="container hero__inner">
      <div class="hero__text">
        <p class="eyebrow">Para negocios de desayunos sorpresa</p>
        <h1>
          Servicios y comunidad para negocios de <em>desayunos sorpresa</em>
        </h1>
        <p class="lead">
          Ofrecemos servicios para pequeños y medianos negocios y dos grupos de WhatsApp: uno para
          conectar con clientes y otro solo para negocios.
        </p>
        <p class="hero-actions">
          <a class="button" href="#solicitud">
            Solicitar ingreso a un grupo
          </a>
          <a href={withBase('servicios/')}>Ver servicios</a>
        </p>
      </div>
      {heroService && (
        <Image
          class="hero__image"
          src={heroService.cover}
          alt={heroService.coverAlt}
          widths={[480, 800, 1000]}
          sizes="(min-width: 60rem) 34rem, 100vw"
          loading="eager"
          fetchpriority="high"
        />
      )}
    </div>
  </section>

  <section class="trust" aria-label="Cómo funciona la comunidad">
    <ul class="container trust__list">
      {trustPoints.map((point) => (
        <li>
          <strong>{point.value}</strong>
          <span>{point.label}</span>
        </li>
      ))}
    </ul>
  </section>

  {featured.length > 0 && (
    <section class="section container" aria-labelledby="destacados">
      <div class="section-heading">
        <h2 id="destacados">Negocios destacados</h2>
        <a href={withBase('negocios/')}>Ver todos los negocios</a>
      </div>
      <Carousel label="Negocios destacados">
        {featured.map((business) => (
          <li>
            <BusinessCard
              name={business.name}
              summary={business.summary}
              city={business.city}
              url={business.url}
              image={business.image}
              imageAlt={business.imageAlt}
              headingLevel={3}
            />
          </li>
        ))}
      </Carousel>
    </section>
  )}

  <section class="section container" aria-labelledby="grupos">
    <h2 id="grupos">Nuestros grupos de WhatsApp</h2>
    <div class="groups">
      {siteConfig.groups.map((group) => (
        <GroupCard
          title={group.title}
          audience={group.audience}
          description={group.description}
          conditionsHref={`${conditionsHref}#${group.id}`}
        />
      ))}
    </div>
  </section>

  <section class="section container" aria-labelledby="solicitud" id="solicitud">
    <h2>Solicita tu ingreso</h2>
    <ol class="steps">
      <li>Completa el formulario y elige el grupo.</li>
      <li>Se abre WhatsApp con tu solicitud lista: envíala.</li>
      <li>
        Un administrador revisa las condiciones y, si se cumplen, te envía el enlace del grupo.
      </li>
    </ol>
    <JoinRequestForm
      groups={siteConfig.groups.map(({ id, title }) => ({ id, title }))}
      adminWhatsApp={siteConfig.adminWhatsApp}
      conditionsHref={conditionsHref}
      privacyHref={withBase('privacidad/')}
      saveEndpoint={siteConfig.joinRequests.endpoint}
    />
  </section>
</BaseLayout>

<style>
  .section-heading {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-1) var(--space-2);
  }
  .hero {
    background: linear-gradient(180deg, var(--color-surface), var(--color-bg));
    border-bottom: 1px solid var(--color-border);
  }

  .hero__inner {
    display: grid;
    gap: var(--space-3);
    align-items: center;
    padding-block: var(--space-4);
  }

  .hero__image {
    width: 100%;
    border-radius: var(--radius);
    box-shadow: 0 1rem 2.5rem rgb(104 36 130 / 0.18);
  }

  .eyebrow {
    margin: 0 0 var(--space-1);
    color: var(--color-primary);
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .trust {
    background: var(--color-primary);
    color: var(--color-primary-text);
  }

  .trust__list {
    display: grid;
    gap: var(--space-2);
    margin-block: 0;
    padding-block: var(--space-3);
    list-style: none;
  }

  .trust__list li {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .trust__list strong {
    min-width: 4.5rem;
    font-family: var(--font-serif);
    font-size: 2rem;
    line-height: 1;
    text-align: center;
  }

  .trust__list span {
    font-size: 0.9375rem;
  }

  @media (min-width: 48rem) {
    .hero__inner {
      grid-template-columns: 1.1fr 1fr;
      gap: var(--space-4);
    }

    .trust__list {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-3);
  }

  .groups {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
    gap: var(--space-2);
  }

  .steps {
    max-width: 40rem;
    margin: 0 0 var(--space-3);
    padding-left: 1.25rem;
  }
</style>
