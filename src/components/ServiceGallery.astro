---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  images: readonly { src: ImageMetadata; alt: string }[];
}

const { images } = Astro.props;
---

{images.length > 0 && (
  <ul class="gallery" aria-label="Galería de fotos">
    {images.map((image) => (
      <li>
        <Image
          src={image.src}
          alt={image.alt}
          widths={[400, 800]}
          sizes="(min-width: 40rem) 45vw, 100vw"
          loading="lazy"
        />
      </li>
    ))}
  </ul>
)}

<style>
  .gallery {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 16rem), 1fr));
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .gallery img {
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    border-radius: var(--radius);
  }
</style>
