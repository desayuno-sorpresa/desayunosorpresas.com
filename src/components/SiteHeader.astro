---
import type { NavItem } from '@/config/site';
import { withBase } from '@/lib/url';

interface Props {
  siteName: string;
  nav: readonly NavItem[];
  /** Texto de la barra superior; sin él, no se muestra. */
  announcement?: string;
  /** Acción destacada a la derecha (p. ej. solicitar ingreso). */
  cta?: { label: string; path: string };
}

const { siteName, nav, announcement, cta } = Astro.props;
const current = Astro.url.pathname;
---

<header class="site-header">
  {announcement && <p class="site-header__announcement">{announcement}</p>}
  <div class="container site-header__inner">
    <button
      class="site-header__toggle"
      type="button"
      aria-expanded="false"
      aria-controls="menu-principal"
      data-menu-toggle
    >
      <span class="site-header__burger" aria-hidden="true"></span>
      <span class="visually-hidden">Menú</span>
    </button>

    <nav id="menu-principal" class="site-header__menu" aria-label="Principal" data-menu>
      <ul class="site-header__nav">
        {nav.map((item) => {
          const href = withBase(item.path);
          return (
            <li>
              <a href={href} aria-current={current === href ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          );
        })}
      </ul>
    </nav>

    <a class="site-header__brand" href={withBase()}>
      {siteName}
    </a>

    {cta && (
      <a class="site-header__cta" href={withBase(cta.path)}>
        {cta.label}
      </a>
    )}
  </div>
</header>

<script>
  document.documentElement.classList.add('js');

  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.querySelector<HTMLElement>('[data-menu]');

  function setOpen(open: boolean): void {
    toggle?.setAttribute('aria-expanded', String(open));
    menu?.toggleAttribute('data-open', open);
  }

  toggle?.addEventListener('click', () => {
    setOpen(toggle.getAttribute('aria-expanded') !== 'true');
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') {
      setOpen(false);
      toggle.focus();
    }
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 5;
    background: var(--color-primary);
    color: var(--color-primary-text);
  }

  .site-header__announcement {
    margin: 0;
    padding: 0.375rem var(--space-2);
    background: var(--color-text);
    color: var(--color-primary-text);
    font-size: 0.875rem;
    text-align: center;
  }

  .site-header__inner {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: var(--space-2);
    padding-block: var(--space-2);
  }

  .site-header a {
    color: inherit;
  }

  .site-header__brand {
    grid-column: 2;
    font-size: 1.25rem;
    font-weight: 700;
    text-align: center;
    text-decoration: none;
  }

  .site-header__menu {
    grid-column: 1;
    grid-row: 1;
  }

  .site-header__nav {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-header__nav a {
    display: inline-block;
    padding-block: 0.25rem;
    text-decoration: none;
    text-transform: uppercase;
    font-size: 0.875rem;
    letter-spacing: 0.04em;
  }

  .site-header__nav a:hover {
    text-decoration: underline;
  }

  .site-header__nav a[aria-current='page'] {
    font-weight: 700;
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.35em;
  }

  .site-header__cta {
    grid-column: 3;
    justify-self: end;
    padding: 0.5rem var(--space-2);
    border: 2px solid currentColor;
    border-radius: var(--radius);
    font-size: 0.875rem;
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
  }

  .site-header__cta:hover {
    background: var(--color-primary-text);
    color: var(--color-primary);
  }

  .site-header__toggle {
    display: none;
    grid-column: 1;
    grid-row: 1;
    justify-self: start;
    padding: 0.75rem;
    border: 0;
    background: transparent;
    color: inherit;
    cursor: pointer;
  }

  .site-header__burger,
  .site-header__burger::before,
  .site-header__burger::after {
    display: block;
    width: 1.5rem;
    height: 2px;
    background: currentColor;
  }

  .site-header__burger {
    position: relative;
  }

  .site-header__burger::before,
  .site-header__burger::after {
    content: '';
    position: absolute;
    left: 0;
  }

  .site-header__burger::before {
    top: -0.45rem;
  }

  .site-header__burger::after {
    top: 0.45rem;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .site-header a:focus-visible,
  .site-header button:focus-visible {
    outline: 3px solid var(--color-primary-text);
    outline-offset: 2px;
  }

  /* Móvil: menú desplegable bajo la barra; sin JS queda siempre visible. */
  @media (max-width: 48rem) {
    :global(html.js) .site-header__toggle {
      display: block;
    }

    .site-header__menu {
      grid-column: 1 / -1;
      grid-row: 2;
    }

    :global(html.js) .site-header__menu:not([data-open]) {
      display: none;
    }

    .site-header__nav {
      flex-direction: column;
    }
  }

  @media (min-width: 48.01rem) {
    .site-header__toggle {
      display: none;
    }
  }
</style>
