---
import { withBase } from '@/lib/url';

interface Props {
  siteName: string;
  contactEmail: string;
  /** Número visible y enlace directo de WhatsApp (sin mensaje). */
  whatsApp: { label: string; href: string } | null;
}

const { siteName, contactEmail, whatsApp } = Astro.props;
---

<footer class="site-footer">
  <div class="container site-footer__inner">
    <div>
      <p>{siteName}</p>
      <p>
        Correo: <a href={`mailto:${contactEmail}`}>{contactEmail}</a>
      </p>
      {whatsApp && (
        <p>
          WhatsApp: <a href={whatsApp.href}>{whatsApp.label}</a>
        </p>
      )}
    </div>
    <ul>
      <li>
        <a href={withBase('condiciones/')}>Condiciones de los grupos</a>
      </li>
      <li>
        <a href={withBase('privacidad/')}>Tratamiento de datos</a>
      </li>
    </ul>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--space-4);
    border-top: 1px solid var(--color-border);
    background: var(--color-surface);
    color: var(--color-muted);
    font-size: 0.95rem;
  }

  .site-footer__inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-2);
    padding-block: var(--space-3);
  }

  .site-footer p {
    margin: 0;
  }

  .site-footer ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }
</style>
